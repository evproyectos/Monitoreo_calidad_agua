# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# El .env NO se versiona: tiene secretos. Las variables definidas en el sistema (setx) tienen
# prioridad sobre las de este archivo.

# --- Clave de API (RNF-004) ----------------------------------------------------------------
# POST /predict/contaminacion pide una de estas claves en el encabezado X-API-Key.
# Varias separadas por coma (sirve para cambiar una clave sin cortar a nadie).
# Generar una:  python -m monitoreo.seguridad --nueva-clave        (desde backend/)
CLAVES_API=

# --- HTTPS (RNF-004, opcional) ------------------------------------------------------------
# Con las dos rutas el servicio atiende solo por HTTPS, con TLS 1.2 como mínimo.
# Rutas absolutas o relativas a esta carpeta. Certificado de prueba para 127.0.0.1:
#   python -m monitoreo.seguridad --certificado                       (desde backend/)
CERTIFICADO_TLS=
CLAVE_TLS=

# --- Alertas por Telegram -----------------------------------------------------------------
TELEGRAM_TOKEN=
# uno o varios chats, separados por coma
TELEGRAM_CHAT_ID=
# 1 (por defecto) o 0: avisar cuando el pronóstico a 24 h sale de la norma
ALERTAS_RIESGO=1
# hora del resumen diario (0-23), o -1 para no enviarlo
ALERTAS_RESUMEN_HORA=7
# enlace que va en los mensajes (https://... si se usa HTTPS)
URL_DASHBOARD=http://127.0.0.1:8001

# --- Servicio (opcionales; estos son los valores por defecto) ----------------------------
# URL_DATOS=http://127.0.0.1:8000
# MODO_PRONOSTICO=combinado
# FUENTE_PRONOSTICO=archivo
# UMBRAL_AMARILLO=0.5
# CARPETA_MODELOS=     (por defecto: modelos/ del proyecto Modelo_calidad_agua)
# CARPETA_REGISTROS=   (por defecto: registros/ de este proyecto)
# PRONOSTICO_LLUVIA=   (por defecto: clima/pronostico_lluvia_modelos.csv del proyecto de modelos)
